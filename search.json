---
---
[
  {% assign visible_posts = site.posts | where_exp: "post", "post.hidden != true" %}
  {% for post in visible_posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "category": {{ post.categories | join: ', ' | jsonify }},
    "date": {{ post.date | date: "%B %e, %Y" | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | normalize_whitespace | truncatewords: 28 | jsonify }},
    "image": {{ post.image | default: '/images/logo.png' | relative_url | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
